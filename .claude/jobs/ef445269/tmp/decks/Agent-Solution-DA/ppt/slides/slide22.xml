" idx="23"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="576263" y="1549400"/><a:ext cx="2532062" cy="2939266"/></a:xfrm></p:spPr><p:txBody><a:bodyPr vert="horz" wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" dirty="0"><a:cs typeface="Segoe Sans Display"/></a:rPr><a:t>Get ready for delivering </a:t></a:r><a:r><a:rPr lang="en-US"><a:cs typeface="Segoe Sans Display"/></a:rPr><a:t>the Agent Solution Deployment </a:t></a:r><a:r><a:rPr lang="en-US" dirty="0"><a:cs typeface="Segoe Sans Display"/></a:rPr><a:t>Accelerator by reviewing the delivery guide, identifying assets and resources that you will use, aligning with your customer stakeholders to agree on the scope of the engagement.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-US"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="Content Placeholder 3"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{85650B26-A9F5-4019-DE56-17A227B1870C}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph sz="quarter" idx="24"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="3417888" y="1549400"/><a:ext cx="2533650" cy="3841436"/></a:xfrm></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:pPr lvl="2"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" dirty="0"/><a:t>Make sure to review the delivery guide and engagement content:</a:t></a:r></a:p><a:p><a:pPr lvl="3"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"/><a:t>Review the </a:t></a:r><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:hlinkClick r:id="rId3"/></a:rPr><a:t>Agents pre-engagement planning guide</a:t></a:r><a:endParaRPr lang="en-US" sz="1300" dirty="0"/></a:p><a:p><a:pPr lvl="3"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" dirty="0"/><a:t>Keep in mind this is a flexible engagement.</a:t></a:r></a:p><a:p><a:pPr lvl="3"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" dirty="0"/><a:t>Identify activity categories and corresponding activities that you will deliver to the customer. Please remember you are not required to deliver activities in any particular order.</a:t></a:r></a:p><a:p><a:pPr lvl="3"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300" dirty="0"/><a:t>Select and download identified assets and resources. Review them and get ready for the delivery.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="5" name="Content Placeholder 4"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{A3D35493-292A-DFFA-1103-1BD6014273CB}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph sz="quarter" idx="25"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="6253163" y="1549400"/><a:ext cx="2533650" cy="4429289"/></a:xfrm></p:spPr><p:txBody><a:bodyPr vert="horz" wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr marL="200660" lvl="2" indent="-200660"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300"/><a:t>Schedule and facilitate the </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300"><a:solidFill><a:srgbClr val="323139"/></a:solidFill></a:rPr><a:t>pre-engagement planning meeting. </a:t></a:r><a:endParaRPr lang="en-US" sz="1300"><a:cs typeface="Segoe Sans Display Semilight"/></a:endParaRPr></a:p><a:p><a:r><a:rPr lang="en-US"><a:solidFill><a:schemeClr val="accent1"><a:lumMod val="75000"/></a:schemeClr></a:solidFill></a:rPr><a:t>In the meeting, be sure to:</a:t></a:r></a:p><a:p><a:pPr marL="200660" lvl="2" indent="-200660"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300"/><a:t>Align and confirm customer stakeholders (executive sponsor, communications lead, training leads, department leads, IT stakeholders)</a:t></a:r></a:p><a:p><a:pPr marL="200660" lvl="2" indent="-200660"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300"/><a:t>If any high-value scenarios were evaluated during the Envisioning engagement, please review them here and adopt if needed.</a:t></a:r></a:p><a:p><a:pPr marL="200660" lvl="2" indent="-200660"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300"/><a:t>Define success of the engagement by documenting vision and goals (Review this resource prior to the meeting: </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" dirty="0"><a:solidFill><a:srgbClr val="0078D4"/></a:solidFill><a:sym typeface=""/><a:hlinkClick r:id="rId4"><a:extLst><a:ext uri="{A12FA001-AC4F-418D-AE19-62706E023703}"><ahyp:hlinkClr xmlns:ahyp="http://schemas.microsoft.com/office/drawing/2018/hyperlinkcolor" val="tx"/></a:ext></a:extLst></a:hlinkClick></a:rPr><a:t>Identify business goals and success metrics</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300"><a:solidFill><a:srgbClr val="0078D4"/></a:solidFill><a:sym typeface=""/></a:rPr><a:t>)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="6" name="Content Placeholder 5"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{6A889D8E-C222-453F-FFB1-91D1DA781D4E}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph sz="quarter" idx="26"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="9086850" y="1549400"/><a:ext cx="2533650" cy="4382738"/></a:xfrm></p:spPr><p:txBody><a:bodyPr vert="horz" wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr marL="200660" lvl="2" indent="-200660"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300"><a:sym typeface=""/></a:rPr><a:t>Share </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300"><a:solidFill><a:srgbClr val="0078D4"/></a:solidFill><a:sym typeface=""/></a:rPr><a:t>Create an AI Council guide </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300"><a:sym typeface=""/></a:rPr><a:t>and</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300"><a:solidFill><a:srgbClr val="0078D4"/></a:solidFill><a:sym typeface=""/></a:rPr><a:t> The Strategic CIOs Generative AI Playbook</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" dirty="0"><a:solidFill><a:srgbClr val="0078D4"/></a:solidFill><a:sym typeface=""/></a:rPr><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300"><a:sym typeface=""/></a:rPr><a:t>with your customer.</a:t></a:r></a:p><a:p><a:pPr marL="200660" lvl="2" indent="-200660"><a:buFont typeface="Wingdings" panose="05000000000000000000" pitchFamily="2" charset="2"/><a:buChar char="q"/></a:pPr><a:r><a:rPr lang="en-US" sz="1300"><a:sym typeface=""/></a:rPr><a:t>If necessary, provide</a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" dirty="0"/><a:t> </a:t></a:r><a:r><a:rPr lang="en-US" sz="1300" dirty="0"><a:solidFill><a:srgbClr val="0078D4"/></a:solidFill><a:sym typeface=""/><a:hlinkClick r:id="rId5"><a:extLst><a:ext uri="{A12FA001-AC4F-418D-AE19-62706E023703}"><ahyp:hlinkClr 